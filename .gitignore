# ============================================================
# Rime 配置仓库（基于雾凇拼音 rime-ice）
# 原则：只备份「个人定制层」，忽略「上游通用内容」和「运行时生成物」。
# 恢复方式：先在本目录铺一份 rime-ice（+ rime-latex 等插件），
#          再 git clone 本仓库叠加个人文件即可。
# ============================================================

# ---------- 1. 运行时生成 / 本机状态（绝不入库） ----------

# 部署编译产物（prism / table / reverse .bin，约 73MB，可重建）
/build/

# 用户词库与调频学习数据（LevelDB 二进制，约 3MB，含 luna_pinyin / rime_ice）
*.userdb/

# 用户数据同步快照（内含完整配置副本，会污染仓库）
/sync/

# Rime 运行状态：上次部署时间、上次使用方案、各方案访问时间
/user.yaml

# 安装信息：前端类型/版本、installation_id（换机器应重新生成）
/installation.yaml

# macOS / 编辑器垃圾文件
.DS_Store
Thumbs.db

# ---------- 2. 通用 rime-ice 内容（可重新下载，不入库） ----------

# 中文词库（约 44MB：8105 / base / ext / tencent 等）
/cn_dicts/

# 英文词库 + 中英混排词表
/en_dicts/

# 官方 Lua 脚本（翻译器 / 过滤器 / 处理器）
/lua/

# Emoji 与简繁转换的 OpenCC 数据
/opencc/

# v 模式符号表
/symbols_v.yaml
/symbols_caps_v.yaml

# 双拼方案（7 种，未定制）
/double_pinyin*.schema.yaml

# 九键方案
/t9.schema.yaml

# 英文方案（自带词库入口，词库本体在 en_dicts/）
/melt_eng.schema.yaml
/melt_eng.dict.yaml

# 部件拆字方案与码表
/radical_pinyin.schema.yaml
/radical_pinyin.dict.yaml

# 主词库入口（未定制；词库内容在 cn_dicts/）
/rime_ice.dict.yaml

# Windows 前端配置（本机为 macOS 鼠须管）
/weasel.yaml

# 上游许可与空目录/残留
/LICENSE
/hydralance/

# ---------- 3. 以下个人文件请保持入库（勿加 ignore） ----------
#
#   .gitignore              本文件
#   README.md               目录说明
#   .vscode/settings.json   编辑器设置
#   rime_ice.schema.yaml    主方案（有本地改动）
#   rime_ice.custom.yaml    你的补丁：模糊音 + LaTeX 输入
#   default.yaml            全局配置（候选数、方案列表等有改动）
#   squirrel.yaml           鼠须管外观 / 前端口味
#   custom_phrase.txt       自定义置顶短语
#   custom_latex_user.txt   LaTeX 用户词库（学习所得）
#   latex.schema.yaml       rime-latex 插件，非 rime-ice 自带
#   latex.dict.yaml         rime-latex 码表
#
# 说明：
# - rime_ice.schema.yaml / default.yaml / squirrel.yaml 是从上游复制后
#   被本地改过的，改法若能改成 *.custom.yaml 补丁会更干净，届时可把
#   这三个文件也加入 ignore。
# - sync/ 里若想保留「用户词库导出」(*_userdb.txt) 以便恢复调频，
#   可单独放开，例如：!/sync/**/*_userdb.txt

!/sync/**/*_userdb.txt
